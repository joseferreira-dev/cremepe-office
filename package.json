{
    "name": "cremepe-office",
    "version": "1.0.0",
    "main": "frontend/main.js",
    "scripts": {
        "start": "electron .",
        "start-backend": "python backend/app.py",
        "dev": "concurrently \"npm run start-backend\" \"npm run start\"",
        "lint": "eslint frontend/js",
        "build:css": "tailwindcss -i frontend/css/input.css -o frontend/css/tailwind.css --minify",
        "watch:css": "tailwindcss -i frontend/css/input.css -o frontend/css/tailwind.css --watch",
        "check:classes": "python scripts/check_frontend_classes.py",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "br.org.cremepe.office",
        "productName": "CREMEPE OFFICE",
        "directories": {
            "output": "dist"
        },
        "files": [
            "frontend/**/*",
            "node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": "backend/dist/backend.exe",
                "to": "backend.exe",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "frontend/assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "electron-store": "^11.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/cli": "^4.3.5",
        "concurrently": "^10.0.3",
        "electron": "^43.1.1",
        "electron-builder": "^26.15.3",
        "eslint": "^10.14.0",
        "tailwindcss": "^4.3.5"
    }
}
