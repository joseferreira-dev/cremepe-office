{
    "name": "cremepe-office",
    "version": "1.0.0",
    "main": "frontend/dist/main.js",
    "scripts": {
        "start": "npm run build:ts && electron .",
        "electron": "electron .",
        "start-backend": "node scripts/run-backend.js",
        "dev": "npm run build:ts && concurrently \"npm run watch:ts\" \"npm run start-backend\" \"npm run electron\"",
        "lint": "eslint \"frontend/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "build:ts": "node scripts/build-ts.js",
        "watch:ts": "node scripts/build-ts.js --watch",
        "build:css": "tailwindcss -i frontend/css/input.css -o frontend/css/tailwind.css --minify",
        "watch:css": "tailwindcss -i frontend/css/input.css -o frontend/css/tailwind.css --watch",
        "check:classes": "python scripts/check_frontend_classes.py",
        "smoke": "node scripts/smoke_nav.js",
        "predist": "npm run build:ts && npm run build:css",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "br.org.cremepe.office",
        "productName": "CREMEPE OFFICE",
        "directories": {
            "output": "dist"
        },
        "files": [
            "frontend/**/*",
            "node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": "backend/dist/backend.exe",
                "to": "backend.exe",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "frontend/assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "electron-store": "^11.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/cli": "^4.3.5",
        "@types/node": "^26.6.6",
        "concurrently": "^10.0.3",
        "electron": "^43.1.1",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0"
    }
}
