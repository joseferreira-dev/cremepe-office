{
    "name": "cremepe-office",
    "version": "1.0.0",
    "main": "frontend/main.js",
    "scripts": {
        "start": "electron .",
        "start-backend": "python backend/app.py",
        "dev": "concurrently \"npm run start-backend\" \"npm run start\"",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "br.org.cremepe.office",
        "productName": "CREMEPE OFFICE",
        "directories": {
            "output": "dist"
        },
        "files": [
            "frontend/**/*",
            "node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": "backend/dist/backend.exe",
                "to": "backend.exe",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "frontend/assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "electron-store": "^11.0.2"
    },
    "devDependencies": {
        "concurrently": "^10.0.3",
        "electron": "^43.1.1",
        "electron-builder": "^26.15.3"
    }
}
